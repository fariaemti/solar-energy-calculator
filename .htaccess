<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Não reescrever se for arquivo ou diretório real
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirecionar requisições para o index.php
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Melhorar performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 week"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/xml+rss
</IfModule>

# Segurança
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "^(process|database)\.php$">
    Require all granted
</FilesMatch>
